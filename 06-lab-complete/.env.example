# Copy thành .env.local rồi điền giá trị thật.
# ❌ TUYỆT ĐỐI KHÔNG commit .env.local lên Git (đã có trong .gitignore).

# ── Server ──────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true

# ── App ─────────────────────────────────
APP_NAME=Production AI Agent
APP_VERSION=1.0.0

# ── LLM (để trống = dùng mock LLM offline) ─
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Security (BẮT BUỘC đổi ở production) ──
AGENT_API_KEY=dev-key-change-me
JWT_SECRET=dev-jwt-secret
ALLOWED_ORIGINS=*

# ── Rate limit & Budget ─────────────────
RATE_LIMIT_PER_MINUTE=10
MONTHLY_BUDGET_USD=10.0

# ── Conversation history ────────────────
MAX_HISTORY_TURNS=20
HISTORY_TTL_SECONDS=86400

# ── Storage ─────────────────────────────
# Có REDIS_URL => stateless (scale nhiều instance). Để trống => in-memory fallback.
REDIS_URL=redis://localhost:6379/0
